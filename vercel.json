{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.js",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/app/main"
    },
    {
      "source": "/api",
      "destination": "/api/app/main"
    },
    {
      "source": "/docs",
      "destination": "/api/app/main"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/app/main"
    },
    {
      "source": "/((?!api(?:/|$)|docs|openapi\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
