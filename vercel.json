{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/app/main"
    },
    {
      "source": "/docs",
      "destination": "/api/app/main"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/app/main"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
